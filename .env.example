# ---- CM4STORE / ambiente ----
PORT=3000
NODE_ENV=development

# URL publica (usada nas URLs de retorno do gateway de pagamento)
PUBLIC_URL=http://localhost:3000

# Banco de dados (opcional em dev).
# Sem MONGODB_URI a aplicacao sobe com repositorio em memoria (dados de demonstracao).
MONGODB_URI=

# Seguranca
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=7d

# Admin criado no seed
ADMIN_EMAIL=admin@cm4store.com
ADMIN_PASSWORD=cm4store123

# Comercial
PRECO_PADRAO=14999.97

# ---- Gateway de pagamento ----
# placeholder = simula a aprovacao (nenhuma cobranca real e feita)
# mercadopago | stripe = integracao real (implementar em src/routes/payments.js)
PAYMENT_GATEWAY=placeholder

# MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
